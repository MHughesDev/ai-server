# Copy to .env for local development (never commit .env).
# Production: OPERATIONAL_BEARER_TOKEN is required (bootstrap fail-fast).
# Generate: openssl rand -hex 32  OR  ./scripts/generate-env.sh

# --- Operational endpoint protection (PR-001) ---
# When set, GET /healthz, /readyz, /metrics, /v1/version require:
#   Authorization: Bearer <token>
OPERATIONAL_BEARER_TOKEN=

# --- Environment ---
NODE_ENV=development

# --- Release traceability (required when PLATFORM_PRODUCTION_ROLLOUT_ENABLED=true in production — PR-004) ---
# RELEASE_ID=2026.05.20.1
# BUILD_ID=git-sha-or-ci-build-id
# PLATFORM_PRODUCTION_ROLLOUT_ENABLED=false
# Set both only after canary sign-off (PR-010):
# ROLLOUT_CANARY_SIGNOFF=true
# PLATFORM_PRODUCTION_ROLLOUT_ENABLED=true

# --- Auth (required in production — PR-003) ---
# REQUIRE_AUTH_HEADER=true
# AUTH_AI_JWT_SECRET=<32+ char secret, not dev-ai-jwt-secret>
# AUTH_QUERY_REQUIRED_SCOPES=query:invoke
# AUTH_IDP_REGISTRY_JSON=[{"issuer":"https://idp.example.com","audience":"ai-server-token-exchange","jwt_algorithm":"HS256","jwt_secret":"<idp-secret>","claim_mapping":{"org_id":"org_id","app_id":"azp","user_id":"sub"}}]
# AUTH_APP_REGISTRY_JSON=[{"client_id":"client-1","client_secret":"<secret>","app_id":"app-1","allowed_issuers":["https://idp.example.com"],"allowed_scopes":["query:invoke"]}]

# --- Model gateway (required in production — PR-002) ---
# Production requires openai_compatible + api_key_env with a non-empty env value + registry routing.
# MODEL_PROVIDER_API_KEY=your-key-here
# MODEL_GATEWAY_PROVIDERS_JSON=[{"id":"openai","kind":"openai_compatible","default_model":"gpt-4o-mini","base_url":"https://api.openai.com/v1","api_key_env":"MODEL_PROVIDER_API_KEY"}]
# MODEL_GATEWAY_REGISTRY_JSON={"chat":{"default":{"provider":"openai","model":"gpt-4o-mini"}}}

# --- Scoped secrets (required in production — PR-005) ---
# Dev default: SECRETS_BACKEND=stub (redacted placeholder). Production: env | aws_secrets_manager | vault
# SECRETS_BACKEND=env
# SCOPED_SECRETS_JSON={"api_key":"<from-k8s-secret-or-external-secrets>"}
# Optional per-key env injection (prefix SCOPED_SECRET_): SCOPED_SECRET_API_KEY=...
# aws_secrets_manager: set SECRETS_AWS_REGION or AWS_REGION; inject secret values via env/JSON above
# vault: set VAULT_ADDR; inject secret values via env/JSON above

# --- Memory (required in production — PR-006) ---
# Dev default: MEMORY_BACKEND=in_memory. Production: vector + REDIS_URL or CHROMA_URL.
# MEMORY_BACKEND=vector
# REDIS_URL=redis://localhost:6379
# CHROMA_URL=http://localhost:8000

# --- Tenant budget (required in production — PR-007) ---
# Shared across instances: REDIS_URL (same as memory) OR TENANT_BUDGET_POSTGRES_URL OR Upstash REST pair.
# TENANT_COST_CAP_USD_PER_HOUR=10
# TENANT_BUDGET_POSTGRES_URL=postgres://user:pass@host:5432/db

# --- Persistent sinks (required in production — PR-012) ---
# AUDIT_LOG_PATH=/var/log/ai-server/audit.jsonl
# OBSERVABILITY_EVENT_SINK_PATH=/var/log/ai-server/events.ndjson
# AUDIT_LOG_MAX_FILE_BYTES=10485760
# AUDIT_LOG_MAX_ROTATED_FILES=3
# OBSERVABILITY_EVENT_SINK_MAX_FILE_BYTES=10485760
# OBSERVABILITY_EVENT_SINK_MAX_ROTATED_FILES=3
# AUDIT_LOG_FSYNC=true
# OBSERVABILITY_EVENT_SINK_FSYNC=true
