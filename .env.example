# Copy to .env for local development (never commit .env).
# Production: OPERATIONAL_BEARER_TOKEN is required (bootstrap fail-fast).
# Generate: openssl rand -hex 32  OR  ./scripts/generate-env.sh

# --- Operational endpoint protection (PR-001) ---
# When set, GET /healthz, /readyz, /metrics, /v1/version require:
#   Authorization: Bearer <token>
OPERATIONAL_BEARER_TOKEN=

# --- Environment ---
NODE_ENV=development

# --- Auth (required when REQUIRE_AUTH_HEADER=true) ---
# AUTH_AI_JWT_SECRET=
# AUTH_IDP_REGISTRY_JSON=
# AUTH_APP_REGISTRY_JSON=

# --- Model gateway (required in production) ---
# MODEL_GATEWAY_PROVIDERS_JSON=
