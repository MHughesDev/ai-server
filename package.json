{
  "name": "ai-server",
  "version": "0.1.0",
  "description": "Production-grade, modular, multimodal AI server with strict cognition boundary",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "lint": "node node_modules/eslint/bin/eslint.js src --ext .ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --coverage --runInBand",
    "eval": "tsx src/eval/run-eval.ts",
    "eval:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPattern=eval/runner.test",
    "acceptance:observability": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPattern=observability-acceptance",
    "start": "node dist/server/index.js",
    "bootstrap": "node dist/bootstrap/index.js",
    "start:dev": "tsx src/server/index.ts",
    "serve": "node dist/server/index.js",
    "serve:dev": "tsx src/server/index.ts",
    "validate:manifests": "node scripts/validate-k8s-manifests.mjs && node scripts/validate-openapi-routes.mjs",
    "release:manifest": "node scripts/release/build-artifact-manifest.mjs",
    "release:sign": "node scripts/release/sign-artifact-manifest.mjs",
    "release:verify": "node scripts/release/verify-artifact-manifest.mjs",
    "release:artifacts": "npm run release:manifest && npm run release:sign && npm run release:verify",
    "smoke:pre-release": "node scripts/pre-release-smoke.mjs",
    "drill:rollback": "npm run build && node scripts/rollback-drill.mjs",
    "drill:incidents": "npm run build && node scripts/incident-drills.mjs",
    "verify:sow": "npm run lint && npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "ioredis": "^5.10.0",
    "pg": "^8.13.0"
  }
}
