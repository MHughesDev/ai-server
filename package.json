{
  "name": "ai-server",
  "version": "0.1.0",
  "description": "Production-grade, modular, multimodal AI server with strict cognition boundary",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "lint": "node node_modules/eslint/bin/eslint.js src --ext .ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --coverage --runInBand",
    "eval": "tsx src/eval/run-eval.ts",
    "eval:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPattern=eval/runner.test",
    "acceptance:observability": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPattern=observability-acceptance",
    "start": "node dist/server/index.js",
    "bootstrap": "node dist/bootstrap/index.js",
    "start:dev": "tsx src/server/index.ts",
    "serve": "node dist/server/index.js",
    "serve:dev": "tsx src/server/index.ts",
    "verify:sow": "npm run lint && npm run typecheck && npm run build && npm test",
    "queue:top-item": "python queue/scripts/queue_top_item.py",
    "queue:peek": "python queue/scripts/queue_peek.py",
    "queue:validate": "python queue/scripts/queue_validate.py",
    "queue:archive": "python queue/scripts/queue_archive.py",
    "queue:archive-top": "python queue/scripts/queue_archive.py --top",
    "queue:graph": "python queue/scripts/queue_graph.py",
    "queue:analyze": "python queue/scripts/queue_analyze.py",
    "queue:test": "python queue/dev_mcp/queue_ops/test_queue_ops.py",
    "queue:pr-merge": "python queue/scripts/queue_pr_merge.py",
    "queue:audit": "python queue/scripts/audit_self.py",
    "skills:list": "python queue/scripts/skills_list.py",
    "idea:queue": "python queue/skills/queue-seeder.py --repo-root ."
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "ioredis": "^5.10.0",
    "pg": "^8.13.0"
  }
}
